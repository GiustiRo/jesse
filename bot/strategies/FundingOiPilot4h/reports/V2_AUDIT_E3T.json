0\\\\n    FINISH = 1672531200000\\\\n\\\",\\\"status\\\":\\\"finished\\\",\\\"sha256\\\":\\\"a47a10a3ccdc51b3164572d3f3889074b14833a3b773783329e04b270e154d11\\\",\\\"session_id\\\":\\\"d546fc9f-90bf-45d4-85b7-fa6d29d4736f\\\",\\\"dashboard_url\\\":\\\"http://localhost:9200/#/backtest/d546fc9f-90bf-45d4-85b7-fa6d29d4736f\\\",\\\"created_at\\\":\\\"2026-10-20T21:19:28.301Z\\\",\\\"started_at\\\":\\\"2026-10-20T21:19:28.586Z\\\",\\\"execution_duration\\\":13.73,\\\"finished_at\\\":\\\"2026-10-20T21:20:09.899Z\\\",\\\"metrics\\\":{\\\"trades\\\":335,\\\"net_pct\\\":-4.121829044724847,\\\"net\\\":-412.1829044724847,\\\"pf\\\":0.9888425447215986,\\\"dd\\\":-36.55693735906337,\\\"fees\\\":3012.372533304195,\\\"funding\\\":-387.08933030000196},\\\"config_ref\\\":\\\"nominal_config\\\",\\\"config_verified\\\":true,\\\"audit_artifact\\\":\\\"strategies/FundingOiPilot4h/reports/AUDIT_ResearchV1_H1_POI_E3T.json\\\",\\\"counter_verified\\\":true,\\\"v2_id\\\":\\\"H1_FIXED_POI\\\",\\\"source_verified\\\":true,\\\"evaluation_already_observed\\\":false},\\\"2f62f8ef-ba51-4308-a10e-8a4514327709\\\":{\\\"id\\\":\\\"H1_ATR_P\\\",\\\"session_id\\\":\\\"2f62f8ef-ba51-4308-a10e-8a4514327709\\\",\\\"name\\\":\\\"ResearchV2_H1_ATR_P_E3T\\\",\\\"start\\\":\\\"2020-09-01\\\",\\\"finish\\\":\\\"2023-01-01\\\",\\\"stage\\\":\\\"E3T\\\",\\\"dashboard_url\\\":\\\"http://localhost:9200/#/backtest/2f62f8ef-ba51-4308-a10e-8a4514327709\\\"},\\\"a0f71b9c-3de8-40d7-a714-7bdfa7492c4c\\\":{\\\"id\\\":\\\"H1_ATR_POI\\\",\\\"session_id\\\":\\\"a0f71b9c-3de8-40d7-a714-7bdfa7492c4c\\\",\\\"name\\\":\\\"ResearchV2_H1_ATR_POI_E3T\\\",\\\"start\\\":\\\"2020-09-01\\\",\\\"finish\\\":\\\"2023-01-01\\\",\\\"stage\\\":\\\"E3T\\\",\\\"dashboard_url\\\":\\\"http://localhost:9200/#/backtest/a0f71b9c-3de8-40d7-a714-7bdfa7492c4c\\\"}}\")\nnominal=json.loads(\"{\\\"logging\\\":{\\\"order_submission\\\":false,\\\"order_cancellation\\\":false,\\\"order_execution\\\":false,\\\"position_opened\\\":false,\\\"position_increased\\\":false,\\\"position_reduced\\\":false,\\\"position_closed\\\":false,\\\"shorter_period_candles\\\":false,\\\"trading_candles\\\":false,\\\"balance_update\\\":false},\\\"warm_up_candles\\\":240,\\\"exchange\\\":{\\\"name\\\":\\\"Binance Perpetual Futures\\\",\\\"type\\\":\\\"futures\\\",\\\"balance\\\":10000,\\\"fee\\\":0.00045,\\\"futures_leverage_mode\\\":\\\"isolated\\\",\\\"futures_leverage\\\":3,\\\"slippage_bps\\\":0},\\\"funding\\\":{\\\"mode\\\":\\\"historical\\\",\\\"dataset_id\\\":\\\"9c5618c2393e7281467184f804c58032b1219a6057ce6a009324ec4cc089f571\\\"},\\\"open_interest\\\":{\\\"mode\\\":\\\"historical\\\",\\\"dataset_id\\\":\\\"6694352b75cba232bf1ffa6aa1d62e54e0cf751582ef0a9c4b49972ebc7e1abf\\\",\\\"allow_missing_observations\\\":true,\\\"max_age_ms\\\":600000}}\")\nimport json, math\nfrom pathlib import Path\nfrom datetime import datetime, timezone\nrows=[]\nfor p in sorted(Path(\"inputs\").glob(\"s*.json\")):\n d=json.load(open(p)); s=d[\"summary\"]; m=d[\"metrics\"]; trades=d[\"trades\"]\n assert s[\"session_status\"]==\"finished\"\n meta=metadata[s[\"session_id\"]]\n assert s[\"form\"][\"start_date\"]==meta[\"start\"] and s[\"form\"][\"finish_date\"]==meta[\"finish\"]\n assert s[\"form\"][\"routes\"][0][\"strategy\"]==meta[\"name\"]\n assert s[\"form\"][\"config\"]==nominal\n assert m.get(\"funding\",{}).get(\"effective_fast_mode\") is False\n ledger=m.get(\"funding\",{}).get(\"ledger\",[])\n errors=[]; stats={}; prices=fees=funding=turnover=holding=0.\n ordered=sorted(trades,key=lambda t:t[\"opened_at\"]); capital=10000.\n pnls=[]; exit_types={}\n for t in ordered:\n  sign=1 if t[\"type\"]==\"long\" else -1\n  gross=sign*(t[\"exit_price\"]-t[\"entry_price\"])*t[\"qty\"]\n  cf=math.fsum(x[\"cashflow\"] for x in ledger if x[\"trade_id\"]==t[\"id\"])\n  errors.extend([abs(gross-t[\"fee\"]+cf-t[\"PNL\"]),abs(cf-t.get(\"funding\",0))])\n  executed=[o for o in t[\"orders\"] if o[\"status\"]==\"EXECUTED\"]\n  errors.append(abs(math.fsum(abs(o[\"filled_qty\"])*o[\"price\"]*.00045 for o in executed)-t[\"fee\"]))\n  for o in executed:\n   turnover+=abs(o[\"filled_qty\"])*o[\"price\"]\n   if o[\"reduce_only\"]: exit_types[o[\"type\"]]=exit_types.get(o[\"type\"],0)+1\n  prices+=gross;fees+=t[\"fee\"];funding+=cf;holding+=t[\"holding_period\"];pnls.append(t[\"PNL\"])\n  side=stats.setdefault(t[\"type\"],dict(n=0,gross=0.,fees=0.,funding=0.,net=0.))\n  side[\"n\"]+=1;side[\"gross\"]+=gross;side[\"fees\"]+=t[\"fee\"];side[\"funding\"]+=cf;side[\"net\"]+=t[\"PNL\"]\n  capital+=t[\"PNL\"]\n net=math.fsum(pnls); positive=math.fsum(x for x in pnls if x>0);negative=math.fsum(x for x in pnls if x<0)\n pf=positive/abs(negative) if negative else None\n errors.extend([abs(net-(m.get(\"net_profit\") or 0)),abs(fees-(m.get(\"fee\") or 0)),abs(funding-m.get(\"funding\",{}).get(\"cashflow\",0))])\n if trades:errors.append(abs(10000+net-m[\"finishing_balance\"]))\n assert max(errors,default=0)<1e-6\n dd=abs(m.get(\"max_drawdown\") or 0)\n pf_pass=bool((pf is not None and pf>=1.2) or (negative==0 and positive>0))\n eligible=bool(len(trades)>=30 and net>0 and pf_pass and dd<=25)\n start=datetime.fromisoformat(s[\"form\"][\"start_date\"]).replace(tzinfo=timezone.utc).timestamp()\n balances={}\n for curve in d[\"equity_curve\"]:\n  if curve[\"name\"]==\"Portfolio\":\n   for pt in sorted(curve[\"data\"],key=lambda x:x[\"time\"]):\n    stamp=pt[\"time\"]-61 if pt[\"time\"]>start else pt[\"time\"]\n    month=datetime.fromtimestamp(stamp,timezone.utc).strftime(\"%Y-%m\")\n    balances[month]=pt[\"value\"]\n previous=10000.;months=[]\n for month,b in sorted(balances.items()):\n  months.append(dict(month=month,return_pct=(b/previous-1)*100,end_equity=b));previous=b\n rows.append(dict(session_id=s[\"session_id\"],strategy=s[\"form\"][\"routes\"][0][\"strategy\"],n=len(trades),\n  id=meta[\"id\"],stage=meta[\"stage\"],start=meta[\"start\"],finish=meta[\"finish\"],dashboard_url=meta[\"dashboard_url\"],\n  net=net,net_pct=net/100,pf=pf,pf_no_losses=negative==0 and positive>0,dd=-dd,turnover=turnover/10000,\n  gross_price=prices,fees=fees,funding=funding,funding_events=len(ledger),holding_seconds=holding,\n  metric_open_indicator_pretermination=m.get(\"total_open_trades\"),metric_open_pl_pretermination=m.get(\"open_pl\"),\n  directions=stats,months=months,exit_order_types=exit_types,eligible=eligible,\n  positive_pnl=positive,negative_pnl=negative,best_trade=max(pnls,default=None),worst_trade=min(pnls,default=None),\n  mean_net_bps=math.fsum(t[\"PNL\"]/abs(t[\"qty\"]*t[\"entry_price\"])*10000 for t in trades)/len(trades) if trades else None,\n  exposure=holding/(datetime.fromisoformat(meta[\"finish\"]).replace(tzinfo=timezone.utc).timestamp()-datetime.fromisoformat(meta[\"start\"]).replace(tzinfo=timezone.utc).timestamp()),\n  gate_failures=[name for name,passed in [(\"trades>=30\",len(trades)>=30),(\"net>0\",net>0),(\"PF>=1.2\",pf_pass),(\"absDD<=25%\",dd<=25)] if not passed],\n  max_accounting_error=max(errors,default=0)))\njson.dump(rows,open(\"output/audit_stage.json\",\"w\"),indent=2)\nprint(json.dumps(rows))\n",
  "limits": [
