# Dashboard password. Change this on the Pi.
PASSWORD=change_me_on_the_pi

APP_PORT=9000
DASHBOARD_URL=http://192.168.1.10:9000

LSP_PORT=9001
MCP_LOG_IN_TERMINAL=true

POSTGRES_HOST=postgres
POSTGRES_NAME=jesse_db
POSTGRES_PORT=5432
POSTGRES_USERNAME=jesse_user
POSTGRES_PASSWORD=password

TIMESCALEDB_ENABLED=TRUE

# Leave empty. Do not install the commercial live plugin.
LICENSE_API_TOKEN=

# Binance USD-M futures. Keys can also be pasted in the dashboard Exchange API Keys page.
BINANCE_REST_BASE_URL=https://fapi.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SYMBOL=BTC-USDT
BINANCE_SOCKS5_PROXY_URL=socks5h://username:password@192.3.13.44:1080
BINANCE_PROXY_REQUIRED=true
BINANCE_ALLOW_TRADING=false

# Optional fallback if no Notification API Key is saved in the dashboard yet.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
