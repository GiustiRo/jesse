{"task": "Propose 8 to 12 NEW programs in the DSL below, as a JSON list only. Goal: a return engine that is NOT long trend-following, adds to an existing book (marginal_vs_book > 0), survives costs x2, and has a good WORST fold. Score = worst fold Sharpe - 0.05 x complexity. Cells with rho_to_book > 0.3 and long bias are blocked.", "dsl": {"program": "{\"universe\": U?, \"signal\": [1-2 pieces], \"filters\": [0-2 pieces], \"exit\": piece, \"size\": {\"kind\": \"voltgt\", \"params\": {\"side\": both|long|short}}, \"exec\": piece}; piece = {\"kind\": ..., \"params\": {...}} with every listed param, values from the grid only", "signals": {"zrev": {"k": [6, 24, 72], "z": [1.5, 2.0, 2.5]}, "rsi2": {"th": [5, 10, 20]}, "shock": {"z": [2, 3, 4], "mode": ["fade", "follow"]}, "spread_z": {"k": [24, 120, 480], "z": [1.5, 2.0, 2.5]}, "voljump": {"ratio": [1.5, 2.0, 3.0], "mode": ["fade", "follow"]}, "clock": {"event": ["E1", "E2", "E3"], "mode": ["fade", "follow"]}, "cascade": {"z_oi": [2, 3], "z_ret": [2, 3], "mode": ["fade", "follow"]}}, "filters": {"volreg": {"band": ["low", "mid", "high"]}, "trendveto": {"k": [20, 60]}, "session": {"s": ["asia", "europe", "us"]}, "leadstate": {"state": ["up", "flat", "down"]}}, "exits": {"time": {"h": [1, 6, 24, 72, 120]}, "atr": {"tgt": [1, 2], "stop": [1, 2, 3]}, "mean": {}}, "execs": {"taker": {}, "maker": {"off": [0.25, 0.5, 1.0], "life": [1, 3, 6]}}, "rules": ["spread_z is the only (and mandatory) signal of pair universes; pairs execute taker", "clock E1/E2 and cascade are only legal on the 2-asset 1h universe of derivative contracts (the one with positioning data); clock/cascade/session need 1h bars", "second signal = confirmation within 6 bars, same direction", "maker: limit off x ATR away, life bars to fill, must be crossed by 1 bp; maker fee 0.018%, taker 0.045% + slippage", "complexity = pieces + params; max 4 pieces, 6 params"], "signal_notes": {"zrev": "fade a k-bar z-score beyond z", "rsi2": "RSI(2) extreme, fade", "shock": "1-bar return beyond z sigma", "spread_z": "fade the pair log-spread z", "voljump": "24-bar vol / 30-day vol above ratio; direction from 24-bar move", "clock": "E1 three fixed daily hours, E2 a weekly reopening hour, E3 month-end; direction from the prior move", "cascade": "open-interest drop beyond z_oi sigma with |return| beyond z_ret"}, "filter_notes": {"volreg": "tercile of 30-day vol vs the prior year", "trendveto": "skip entries against a k-day move beyond 1 sigma", "session": "UTC hour blocks", "leadstate": "trend state (90-day) of the lead asset of the market"}}, "universes": {"U5": {"tf": "1h", "members": ["A", "B", "C", "D", "E", "F", "G"]}, "U2": {"tf": "1d", "members": ["A", "B", "C", "D", "E", "F", "G"]}, "U4": {"tf": "1h", "members": ["C", "E"]}, "U1": {"tf": "1h", "members": ["A", "B", "D", "F", "G"]}, "U8": {"tf": "1h", "members": ["E/C"]}, "U6": {"tf": "1h", "members": ["A/G"]}, "U3": {"tf": "1h", "members": ["F/B"]}, "U7": {"tf": "1h", "members": ["D/F"]}}, "elites": [{"program": {"universe": "U6", "signal": [{"kind": "spread_z", "params": {"k": 24, "z": 2.5}}], "filters": [], "exit": {"kind": "time", "params": {"h": 6}}, "size": {"kind": "voltgt", "params": {"side": "short"}}, "exec": {"kind": "taker", "params": {}}}, "score": 1.827, "cell": "rho0|hold0|neutral", "sharpe": 3.17, "sharpe_cost2": 1.1, "marginal_vs_book": 0.47, "trades_hundreds": 3.9, "maker_unfilled_hundreds": 0.0, "folds": {"G2:F5": [2.54, 0.6], "G2:F3": [2.08, 0.6], "G2:F2": [4.02, 0.7], "G2:F4": [4.4, 0.7], "G2:F1": [3.31, 0.6], "G2:F6": [2.36, 0.6]}}, {"program": {"universe": "U4", "signal": [{"kind": "voljump", "params": {"mode": "fade", "ratio": 1.5}}], "filters": [{"kind": "session", "params": {"s": "europe"}}], "exit": {"kind": "atr", "params": {"stop": 2, "tgt": 2}}, "size": {"kind": "voltgt", "params": {"side": "short"}}, "exec": {"kind": "taker", "params": {}}}, "score": -0.002, "cell": "rho0|hold0|short", "sharpe": 0.71, "sharpe_cost2": 0.58, "marginal_vs_book": 0.087, "tr